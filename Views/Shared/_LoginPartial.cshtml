﻿@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> signInManager;
@inject UserManager<User> userManager;

@{
    var currentUser = signInManager.IsSignedIn(User) ? await userManager.GetUserAsync(User) : null;
}

<div class="d-flex align-items-center gap-2">
    @if (signInManager.IsSignedIn(User) && currentUser != null)
    {
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-dark btn-sm">Выход</button>
        </form>
    }
    else
    {
        <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">
            Войти
        </a>
        <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Register">
            Регистрация
        </a>
    }
</div>