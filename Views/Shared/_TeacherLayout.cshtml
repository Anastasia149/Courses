<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - LearnHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="teacher-dashboard">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-graduation-cap"></i>
                    <span>LearnHub</span>
                </div>
                <div class="dashboard-title">Панель преподавателя</div>
            </div>
            <nav class="sidebar-nav">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <a asp-controller="Teacher" asp-action="Index" class="nav-item @(currentController == "Teacher" && currentAction == "Index" ? "active" : "")">
                    <i class="fas fa-book"></i>
                    <span>Мои курсы</span>
                </a>
                <a asp-controller="Teacher" asp-action="CreateCourse" class="nav-item @(currentController == "Teacher" && currentAction == "CreateCourse" ? "active" : "")">
                    <i class="fas fa-plus"></i>
                    <span>Создать курс</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fas fa-chart-bar"></i>
                    <span>Аналитика</span>
                </a>
                <a asp-controller="Notification" asp-action="Index" class="nav-item @(currentController == "Notification" && currentAction == "Index" ? "active" : "")">
                    <i class="fas fa-bell"></i>
                    <span>Уведомления</span>
                    @if (ViewBag.UnreadNotificationsCount > 0)
                    {
                        <span class="badge bg-danger">@ViewBag.UnreadNotificationsCount</span>
                    }
                </a>
                <a asp-controller="Home" asp-action="Teacher" class="nav-item @(currentController == "Home" && currentAction == "Teacher" ? "active" : "")">
                    <i class="fas fa-cog"></i>
                    <span>Настройки</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="nav-item logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link nav-link-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Выход</span>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #f5f7fa;
    }

    .teacher-dashboard {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        width: 260px;
        background: #fff;
        box-shadow: 2px 0 8px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        position: fixed;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-header {
        padding: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .logo i {
        color: #1976d2;
    }

    .dashboard-title {
        font-size: 0.875rem;
        color: #666;
        font-weight: 500;
    }

    .sidebar-nav {
        flex: 1;
        padding: 1rem 0;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.5rem;
        color: #4b5563;
        text-decoration: none;
        transition: all 0.2s ease;
        position: relative;
    }

    .nav-item:hover {
        background-color: #f3f4f6;
        color: #1a1a1a;
    }

    .nav-item.active {
        background-color: #e3f2fd;
        color: #1976d2;
        font-weight: 500;
    }

    .nav-item.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background-color: #1976d2;
    }

    .nav-item i {
        width: 20px;
        text-align: center;
    }

    .nav-item .badge {
        margin-left: auto;
    }

    .logout-form {
        border-top: 1px solid #e5e7eb;
        margin-top: auto;
        padding: 0;
    }

    .nav-link-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.5rem;
        width: 100%;
        text-align: left;
        border: none;
        background: none;
        color: #4b5563;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .nav-link-btn:hover {
        background-color: #f3f4f6;
        color: #1a1a1a;
    }

    /* Main Content */
    .main-content {
        flex: 1;
        margin-left: 260px;
        padding: 2rem;
        min-height: 100vh;
    }

    @@media (max-width: 768px) {
        .sidebar {
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .main-content {
            margin-left: 0;
        }
    }
</style>

