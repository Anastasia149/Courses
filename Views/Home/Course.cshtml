@using Courses.ViewModels;
@model TeacherCoursesViewModel
@{
    ViewData["Title"] = "Мои курсы";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="courses-page">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Мои курсы</h1>
            <p class="page-subtitle">Управляйте и отслеживайте свои курсы</p>
        </div>
        <a asp-controller="Teacher" asp-action="CreateCourse" class="btn btn-primary btn-create">
            <i class="fas fa-plus"></i> Создать новый курс
        </a>
    </div>

    <!-- Course Management Section -->
    <div class="course-management">
        <h2 class="section-title">Управление курсами</h2>
        @if (Model?.Courses != null && Model.Courses.Any())
        {
            <div class="courses-table-container">
                <table class="courses-table">
                    <thead>
                        <tr>
                            <th>Курс</th>
                            <th>Статус</th>
                            <th>Студенты</th>
                            <th>Рейтинг</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            var studentsCount = course.UserCourses?.Count ?? 0;
                            var averageRating = course.Reviews?.Any() == true 
                                ? course.Reviews.Average(r => r.Rating) 
                                : 0.0;
                            var reviewsCount = course.Reviews?.Count ?? 0;
                            
                            <tr>
                                <td>
                                    <div class="course-info">
                                        <div class="course-thumbnail">
                                            @if (!string.IsNullOrEmpty(course.CoverImagePath))
                                            {
                                                <img src="@course.CoverImagePath" alt="@course.Title" />
                                            }
                                            else
                                            {
                                                <img src="https://via.placeholder.com/80x60?text=@Uri.EscapeDataString(course.Title.Substring(0, Math.Min(10, course.Title.Length)))" 
                                                     alt="@course.Title" />
                                            }
                                        </div>
                                        <div class="course-details">
                                            <div class="course-title">@course.Title</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-published">Опубликован</span>
                                </td>
                                <td>
                                    <div class="students-info">
                                        <i class="fas fa-users"></i>
                                        <span>@studentsCount</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="rating-info">
                                        <i class="fas fa-star"></i>
                                        <span>@averageRating.ToString("F1")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-controller="Teacher" asp-action="CourseDetails" asp-route-id="@course.Id" 
                                           class="btn btn-sm btn-outline-secondary">
                                            Статистика
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <h3>У вас пока нет курсов</h3>
                <p class="text-muted">Создайте свой первый курс, чтобы начать обучение студентов</p>
                <a asp-controller="Teacher" asp-action="CreateCourse" class="btn btn-primary mt-3">
                    <i class="fas fa-plus"></i> Создать курс
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .courses-page {
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: #666;
            font-size: 1rem;
        }

        .btn-create {
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background-color: #000;
            border-color: #000;
            color: #fff;
        }

        .btn-create:hover {
            background-color: #333;
            border-color: #333;
        }

        .course-management {
            background: #fff;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 1.5rem;
        }

        .courses-table-container {
            overflow-x: auto;
        }

        .courses-table {
            width: 100%;
            border-collapse: collapse;
        }

        .courses-table thead {
            background-color: #f9fafb;
            border-bottom: 2px solid #e5e7eb;
        }

        .courses-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: #374151;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .courses-table td {
            padding: 1rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .courses-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .course-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .course-thumbnail {
            width: 80px;
            height: 60px;
            border-radius: 8px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .course-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .course-details {
            flex: 1;
        }

        .course-title {
            font-weight: 600;
            color: #1a1a1a;
            font-size: 0.95rem;
        }

        .status-badge {
            display: inline-block;
            padding: 0.375rem 0.75rem;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .status-published {
            background-color: #000;
            color: #fff;
        }

        .status-draft {
            background-color: #e5e7eb;
            color: #4b5563;
        }

        .students-info,
        .rating-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #4b5563;
        }

        .students-info i,
        .rating-info i {
            color: #9ca3af;
        }

        .rating-info i {
            color: #fbbf24;
        }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }

        .empty-icon {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                gap: 1rem;
            }

            .btn-create {
                width: 100%;
                justify-content: center;
            }

            .courses-table {
                font-size: 0.875rem;
            }

            .course-thumbnail {
                width: 60px;
                height: 45px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }
    </style>
}
