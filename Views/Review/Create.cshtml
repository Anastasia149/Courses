@model Courses.ViewModels.CreateReviewViewModel
@{
    ViewData["Title"] = "Оставить отзыв";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Оставить отзыв на курс: @Model.CourseTitle</h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="@(ViewBag.ReviewId != null ? "Edit" : "Create")" asp-controller="Review" method="post">
                        <input type="hidden" asp-for="CourseId" />
                        <input type="hidden" asp-for="CourseTitle" />
                        @if (ViewBag.ReviewId != null)
                        {
                            <input type="hidden" name="id" value="@ViewBag.ReviewId" />
                        }

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Оценка *</label>
                            <div class="rating-input">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" asp-for="Rating" value="@i" id="rating@i" />
                                    <label for="rating@i" class="star-label">
                                        <i class="fas fa-star"></i>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Отзыв</label>
                            <textarea asp-for="Description" class="form-control" rows="5" 
                                      placeholder="Расскажите о вашем опыте прохождения курса..." 
                                      maxlength="1000"></textarea>
                            <small class="text-muted">Максимум 1000 символов</small>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-controller="Review" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">Отмена</a>
                            <button type="submit" class="btn btn-primary">
                                @(ViewBag.ReviewId != null ? "Обновить отзыв" : "Оставить отзыв")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .rating-input input[type="radio"] {
        display: none;
    }

    .rating-input .star-label {
        cursor: pointer;
        font-size: 2rem;
        color: #ddd;
        transition: color 0.2s;
    }

    .rating-input .star-label:hover,
    .rating-input .star-label:hover ~ .star-label {
        color: #ffc107;
    }

    .rating-input input[type="radio"]:checked ~ .star-label,
    .rating-input input[type="radio"]:checked ~ .star-label ~ .star-label {
        color: #ffc107;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

