@using Courses.ViewModels
@using Courses.Models
@model StudentLessonViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="lesson-page">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Course">Моё обучение</a></li>
            <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@ViewBag.CourseId">@ViewBag.CourseTitle</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <!-- Lesson Header -->
    <div class="lesson-header mb-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="flex-grow-1">
                <h1 class="lesson-title">@Model.Title</h1>
                @if (!string.IsNullOrEmpty(ViewBag.ModuleTitle))
                {
                    <p class="lesson-module text-muted mb-0">
                        <i class="fas fa-folder me-1"></i>@ViewBag.ModuleTitle
                    </p>
                }
            </div>
            <a asp-action="CourseDetails" asp-route-id="@ViewBag.CourseId" class="btn btn-white">
                <i class="fas fa-arrow-left me-2"></i>Вернуться к курсу
            </a>
        </div>

        <!-- Navigation between lessons -->
        <div class="lesson-navigation d-flex justify-content-between">
            @if (ViewBag.PreviousLessonId != null)
            {
                <a asp-action="Lesson" asp-route-id="@ViewBag.PreviousLessonId" class="btn btn-white">
                    <i class="fas fa-chevron-left me-2"></i>Предыдущий урок
                </a>
            }
            else
            {
                <div></div>
            }
            @if (ViewBag.NextLessonId != null)
            {
                <a asp-action="Lesson" asp-route-id="@ViewBag.NextLessonId" class="btn btn-white">
                    Следующий урок<i class="fas fa-chevron-right ms-2"></i>
                </a>
            }
        </div>
    </div>

    <!-- Lesson Content -->
    <div class="lesson-content-card">
        <!-- Lesson Description -->
        <div class="lesson-description-section mb-4">
            <h5 class="section-subtitle mb-3">Описание урока</h5>
            <div class="lesson-description">
                @Html.Raw(Model.Description)
            </div>
        </div>

        <!-- Lesson Materials -->
        @if (Model.Files != null && Model.Files.Any())
        {
            <div class="lesson-materials-section mb-4">
                <h5 class="section-subtitle mb-3">
                    <i class="fas fa-paperclip me-2"></i>Материалы урока
                </h5>
                <div class="materials-list d-flex flex-wrap gap-3">
                    @foreach (var file in Model.Files)
                    {
                        <div class="material-card">
                            @if (file.FileName.ToLower().EndsWith(".jpg") || file.FileName.ToLower().EndsWith(".jpeg") || file.FileName.ToLower().EndsWith(".png") || file.FileName.ToLower().EndsWith(".gif"))
                            {
                                <div class="material-preview">
                                    <img src="@file.FilePath" alt="@file.FileName" />
                                </div>
                            }
                            else
                            {
                                <div class="material-icon">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                            }
                            <a href="@file.FilePath" target="_blank" class="material-link">
                                <i class="fas fa-download me-1"></i>@file.FileName
                            </a>
                        </div>
                    }
                </div>  
            </div>
        }
        
        <!-- Homework Section -->
        <div class="homework-section mb-4">
            <h5 class="section-subtitle mb-3">
                <i class="fas fa-tasks me-2"></i>Домашнее задание
            </h5>
            @await Html.PartialAsync("_HomeworkSubmission", Model)
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
            <h5 class="section-subtitle mb-3">
                <i class="fas fa-comments me-2"></i>Комментарии к заданию
            </h5>
            <div id="commentsList" class="comments-list mb-3"></div>
            <form id="addCommentForm" class="comment-form">
                <div class="mb-2">
                    <textarea class="form-control" id="commentText" rows="3" placeholder="Добавить комментарий..." required maxlength="1000"></textarea>
                    <small class="text-muted">Максимум 1000 символов</small>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-paper-plane me-1"></i>Отправить комментарий
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .lesson-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .lesson-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .lesson-title {
        font-size: 2rem;
        font-weight: 600;
        color: #fff;
        margin: 0;
    }

    .lesson-module {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1rem;
        margin-top: 0.5rem;
    }

    .lesson-navigation {
        margin-top: 1.5rem;
        gap: 1rem;
    }

    .btn-white {
        background-color: rgba(255, 255, 255, 0.2);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-white:hover {
        background-color: rgba(255, 255, 255, 0.3);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
    }

    .lesson-content-card {
        background: #fff;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-top: 2rem;
    }

    .section-subtitle {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 1rem;
    }

    .lesson-description-section {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .lesson-description {
        color: #374151;
        line-height: 1.6;
    }

    .lesson-materials-section {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .material-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f9fafb;
        transition: all 0.2s ease;
        min-width: 150px;
    }

    .material-card:hover {
        background: #f3f4f6;
        border-color: #d1d5db;
        transform: translateY(-2px);
    }

    .material-preview {
        width: 80px;
        height: 80px;
        margin-bottom: 0.5rem;
        border-radius: 6px;
        overflow: hidden;
    }

    .material-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .material-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        border-radius: 6px;
        margin-bottom: 0.5rem;
    }

    .material-icon i {
        font-size: 2rem;
        color: #3b82f6;
    }

    .material-link {
        color: #1a1a1a;
        text-decoration: none;
        font-size: 0.875rem;
        text-align: center;
        word-break: break-word;
    }

    .material-link:hover {
        color: #1976d2;
        text-decoration: underline;
    }

    .homework-section {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .comments-section {
        padding-top: 1.5rem;
    }

    .comments-list {
        max-height: 500px;
        overflow-y: auto;
        padding: 1rem;
        background: #f9fafb;
        border-radius: 8px;
    }

    .comment-item {
        background: #fff;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        border: 1px solid #e5e7eb;
    }

    .comment-item:last-child {
        margin-bottom: 0;
    }

    .comment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .comment-author {
        font-weight: 600;
        color: #1a1a1a;
    }

    .comment-date {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .comment-text {
        color: #374151;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    .comment-actions {
        display: flex;
        gap: 0.5rem;
    }

    .comment-form {
        background: #f9fafb;
        padding: 1rem;
        border-radius: 8px;
    }

    @@media (max-width: 768px) {
        .lesson-title {
            font-size: 1.5rem;
        }

        .lesson-content-card {
            padding: 1rem;
        }

        .lesson-navigation {
            flex-direction: column;
        }

        .lesson-navigation .btn {
            width: 100%;
        }

        .materials-list {
            flex-direction: column;
        }

        .material-card {
            width: 100%;
        }
    }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/homework-submission.js"></script>
<script src="~/js/lesson-comments.js"></script>
<script>
    // Устанавливаем lessonId для комментариев
    window.lessonIdForComments = @Model.Id;
</script>

