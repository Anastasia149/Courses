<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/homework-submission.js"></script>
<script src="~/js/lesson-comments.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filter functionality
        const filterButtons = document.querySelectorAll('.filter-btn');
        const lessonItems = document.querySelectorAll('.lesson-item');

        filterButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                // Remove active class from all buttons
                filterButtons.forEach(b => b.classList.remove('active'));
                // Add active class to clicked button
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                lessonItems.forEach(item => {
                    const lessonType = item.getAttribute('data-lesson-type');
                    const isCompleted = item.getAttribute('data-completed') === 'true';

                    if (filter === 'all') {
                        item.classList.remove('hidden');
                    } else if (filter === 'assignments') {
                        if (lessonType === 'assignment') {
                            item.classList.remove('hidden');
                        } else {
                            item.classList.add('hidden');
                        }
                    } else if (filter === 'unfinished') {
                        if (!isCompleted) {
                            item.classList.remove('hidden');
                        } else {
                            item.classList.add('hidden');
                        }
                    }
                });
            });
        });

    });

    function toggleModule(moduleId) {
        const moduleContent = document.getElementById('module-' + moduleId);
        const moduleHeader = moduleContent.previousElementSibling;
        
        if (moduleContent.classList.contains('show')) {
            moduleContent.classList.remove('show');
            moduleHeader.classList.remove('active');
        } else {
            moduleContent.classList.add('show');
            moduleHeader.classList.add('active');
        }
    }
</script>
