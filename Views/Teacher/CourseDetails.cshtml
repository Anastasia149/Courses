@using Courses.ViewModels
@model CourseDetailsViewModel
@{
    ViewData["Title"] = $"Управление курсом: {Model.Course.Title}";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="course-details-page">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">Управление курсом: @Model.Course.Title</h1>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs course-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#content" type="button" role="tab">
                Контент
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#students" type="button" role="tab">
                Студенты
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#analytics" type="button" role="tab">
                Отзывы
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">
                Настройки курса
            </button>
        </li>
    </ul>

    <!-- Action Buttons -->
    <div class="action-buttons-bar">
        <!-- Buttons for Content tab -->
        <div id="content-buttons" class="tab-buttons">
            <a asp-controller="Teacher" asp-action="AddLesson" asp-route-courseId="@Model.Course.Id" class="btn btn-primary">
                <i class="fas fa-plus"></i> Создать урок
            </a>
            <a asp-controller="Teacher" asp-action="CreateModule" asp-route-courseId="@Model.Course.Id" class="btn btn-outline-secondary">
                <i class="fas fa-plus"></i> Добавить модуль
            </a>
        </div>
        <!-- Button for Students tab -->
        <div id="students-buttons" class="tab-buttons" style="display: none;">
            <a asp-controller="CourseInvitation" asp-action="Invite" asp-route-courseId="@Model.Course.Id" class="btn btn-primary">
                <i class="fas fa-plus"></i> Добавить студента
            </a>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Content Tab -->
        <div class="tab-pane fade show active" id="content" role="tabpanel">
            @{
                var lessonsByModule = Model.Course.Lessons?
                    .OrderBy(l => l.Module?.OrderNumber ?? int.MaxValue)
                    .ThenBy(l => l.Order)
                    .GroupBy(l => l.Module)
                    .ToList() ?? new List<IGrouping<Module, Lesson>>();
            }

            @if (lessonsByModule.Any())
            {
                <div class="modules-list">
                    @foreach (var moduleGroup in lessonsByModule)
                    {
                        var module = moduleGroup.Key;
                        var lessons = moduleGroup.OrderBy(l => l.Order).ToList();
                        var moduleId = module?.Id ?? 0;
                        var moduleTitle = module?.Title ?? "Без модуля";
                        var lessonsCount = lessons.Count;

                        <div class="module-card">
                            <div class="module-header" data-bs-toggle="collapse" data-bs-target="#module-@moduleId" aria-expanded="true">
                                <div class="module-title">
                                    <i class="fas fa-chevron-down me-2"></i>
                                    <span>@moduleTitle</span>
                                </div>
                                <span class="lessons-count">@lessonsCount @(lessonsCount == 1 ? "урок" : lessonsCount < 5 ? "урока" : "уроков")</span>
                            </div>
                            <div class="collapse show" id="module-@moduleId">
                                <div class="module-content">
                                    @foreach (var lesson in lessons)
                                    {
                                        var lessonFilesPath = $"/uploads/lessons/{lesson.Id}/";
                                        var homeworksCount = lesson.Homeworks?.Count(h => h.Status == HomeworkStatus.Pending) ?? 0;
                                        var submittedHomeworksCount = lesson.Homeworks?.Count(h => h.Status != HomeworkStatus.Cancelled) ?? 0;
                                        var isAssignment = lesson.Homeworks != null && lesson.Homeworks.Any();
                                        
                                        <div class="lesson-item">
                                            <div class="lesson-info" style="cursor: pointer;" onclick="location.href='@Url.Action("ReviewLessonAssignments", "Teacher", new { lessonId = lesson.Id })'">
                                                <div class="lesson-number">Урок @lesson.Order</div>
                                                <div class="lesson-type">
                                                    <i class="fas fa-file-alt"></i> Текст
                                                </div>
                                                <div class="lesson-title">@lesson.Title</div>
                                            </div>
                                            <div class="lesson-actions">
                                                @{
                                                    var filesCount = 0;
                                                    try
                                                    {
                                                        var filesPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads", "lessons", lesson.Id.ToString());
                                                        if (Directory.Exists(filesPath))
                                                        {
                                                            filesCount = Directory.GetFiles(filesPath).Length;
                                                        }
                                                    }
                                                    catch { }
                                                }
                                                @if (filesCount > 0)
                                                {
                                                    <span class="attachments-badge" title="Вложения">
                                                        <i class="fas fa-paperclip"></i> @filesCount
                                                    </span>
                                                }
                                                @if (isAssignment)
                                                {
                                                    <span class="assignment-badge" title="Сдано заданий: @submittedHomeworksCount из @Model.EnrolledStudentsCount">
                                                        @submittedHomeworksCount/@Model.EnrolledStudentsCount
                                                    </span>
                                                }
                                                <a asp-controller="Teacher" asp-action="EditLesson" asp-route-id="@lesson.Id" class="btn-icon" title="Редактировать">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </a>
                                                <form asp-controller="Teacher" asp-action="DeleteLesson" method="post" class="d-inline" onsubmit="return confirm('Удалить этот урок?');">
                                                    <input type="hidden" name="id" value="@lesson.Id" />
                                                    <button type="submit" class="btn-icon text-danger" title="Удалить">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-book-open"></i>
                    <p>В этом курсе пока нет уроков</p>
                    <a asp-controller="Teacher" asp-action="AddLesson" asp-route-courseId="@Model.Course.Id" class="btn btn-primary mt-3">
                        <i class="fas fa-plus"></i> Создать первый урок
                    </a>
                </div>
            }
        </div>

        <!-- Students Tab -->
        <div class="tab-pane fade" id="students" role="tabpanel">
            @if (Model.EnrolledStudents != null && Model.EnrolledStudents.Any())
            {
                <div class="students-table-container">
                    <table class="students-table">
                        <thead>
                            <tr>
                                <th>Имя</th>
                                <th>Email</th>
                                <th>Дата регистрации</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.EnrolledStudents)
                            {
                                var enrollments = ViewBag.Enrollments as Dictionary<string, DateTime>;
                                var enrollmentDate = enrollments?.ContainsKey(student.Id) == true ? enrollments[student.Id] : (DateTime?)null;
                                <tr>
                                    <td>
                                        <div class="student-info">
                                            @if (!string.IsNullOrEmpty(student.AvatarPath))
                                            {
                                                <img src="@student.AvatarPath" alt="@student.FullName" class="student-avatar" />
                                            }
                                            else
                                            {
                                                <div class="student-avatar-placeholder">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                            }
                                            <span>@student.FullName</span>
                                        </div>
                                    </td>
                                    <td>@student.Email</td>
                                    <td>@(enrollmentDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td>
                                        <form asp-controller="Teacher" asp-action="RemoveStudentFromCourse" method="post" class="d-inline" onsubmit="return confirm('Удалить студента из курса?');">
                                            <input type="hidden" name="courseId" value="@Model.Course.Id" />
                                            <input type="hidden" name="userId" value="@student.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-user-minus"></i> Удалить
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <p>В курсе пока нет студентов</p>
                </div>
            }
        </div>

        <!-- Analytics Tab -->
        <div class="tab-pane fade" id="analytics" role="tabpanel">
            <div class="analytics-content">
                <h3 class="mb-4">Отзывы студентов</h3>
                
                @if (ViewBag.Reviews != null)
                {
                    var reviews = ViewBag.Reviews as List<Courses.Models.Review>;
                    var averageRating = ViewBag.AverageRating as double? ?? 0;
                    var totalReviews = ViewBag.TotalReviews as int? ?? 0;

                    @if (reviews.Any())
                    {
                        <div class="rating-summary mb-4 p-3 bg-light rounded">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h4 class="mb-2">Средняя оценка</h4>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="average-rating-large">@averageRating.ToString("F1")</span>
                                        <div class="stars-inline">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Math.Round(averageRating) ? "active" : "")"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-0"><strong>Всего отзывов:</strong> @totalReviews</p>
                                </div>
                            </div>
                        </div>

                        <div class="reviews-list">
                            <h5 class="mb-3">Все отзывы</h5>
                            @foreach (var review in reviews)
                            {
                                <div class="review-item border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <strong>@review.User.FullName</strong>
                                            <div class="stars-inline mt-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fas fa-star @(i <= review.Rating ? "active" : "")"></i>
                                                }
                                            </div>
                                        </div>
                                        <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(review.Description))
                                    {
                                        <p class="mb-0">@review.Description</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-comments fa-3x mb-3"></i>
                            <p>Пока нет отзывов от студентов</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Course Settings Tab -->
        <div class="tab-pane fade" id="settings" role="tabpanel">
            <div class="settings-content">
                <div class="settings-section">
                    <h3>Основные настройки</h3>
                    <a asp-controller="Teacher" asp-action="EditCourse" asp-route-id="@Model.Course.Id" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Редактировать курс
                    </a>
                </div>
                <div class="settings-section">
                    <h3>Опасная зона</h3>
                    <form asp-controller="Teacher" asp-action="DeleteCourse" method="post" onsubmit="return confirm('Вы действительно хотите удалить курс? Это действие нельзя отменить!');">
                        <input type="hidden" name="id" value="@Model.Course.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Удалить курс
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .course-details-page {
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1a1a1a;
        }

        .course-tabs {
            border-bottom: 2px solid #e5e7eb;
            margin-bottom: 1.5rem;
        }

        .course-tabs .nav-link {
            color: #6b7280;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            border: none;
            border-bottom: 3px solid transparent;
        }

        .course-tabs .nav-link:hover {
            color: #1976d2;
            border-bottom-color: #e5e7eb;
        }

        .course-tabs .nav-link.active {
            color: #1976d2;
            border-bottom-color: #1976d2;
            background: none;
        }

        .action-buttons-bar {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .modules-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .module-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }

        .module-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            background: #f9fafb;
            cursor: pointer;
            transition: background 0.2s;
        }

        .module-header:hover {
            background: #f3f4f6;
        }

        .module-title {
            display: flex;
            align-items: center;
            font-weight: 600;
            color: #1a1a1a;
        }

        .lessons-count {
            color: #6b7280;
            font-size: 0.875rem;
        }

        .module-content {
            padding: 0.5rem;
        }

        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .lesson-item:last-child {
            border-bottom: none;
        }

        .lesson-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex: 1;
        }

        .lesson-number {
            color: #6b7280;
            font-size: 0.875rem;
            min-width: 60px;
        }

        .lesson-type {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #6b7280;
            font-size: 0.875rem;
            min-width: 80px;
        }

        .lesson-title {
            font-weight: 500;
            color: #1a1a1a;
        }

        .lesson-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .attachments-badge,
        .homeworks-badge,
        .assignment-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: #f3f4f6;
            border-radius: 4px;
            font-size: 0.875rem;
            color: #6b7280;
        }

        .homeworks-badge {
            background: #fef3c7;
            color: #92400e;
        }

        .assignment-badge {
            background: #dbeafe;
            color: #1e40af;
            font-weight: 500;
        }

        .btn-icon {
            background: none;
            border: none;
            color: #6b7280;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .btn-icon:hover {
            background: #f3f4f6;
            color: #1a1a1a;
        }

        .students-table-container {
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }

        .students-table {
            width: 100%;
            border-collapse: collapse;
        }

        .students-table thead {
            background: #f9fafb;
        }

        .students-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: #374151;
            font-size: 0.875rem;
        }

        .students-table td {
            padding: 1rem;
            border-top: 1px solid #e5e7eb;
        }

        .student-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .student-avatar,
        .student-avatar-placeholder {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .student-avatar-placeholder {
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: #6b7280;
        }

        .empty-state i {
            font-size: 3rem;
            color: #d1d5db;
        }

        .stars-inline {
            display: flex;
            gap: 2px;
        }

        .stars-inline i {
            color: #ddd;
            font-size: 0.9rem;
        }

        .stars-inline i.active {
            color: #ffc107;
        }

        .average-rating-large {
            font-size: 2rem;
            font-weight: 600;
            color: #1a1a1a;
        }

        .review-item:last-child {
            border-bottom: none !important;
            margin-bottom: 0 !important;
            padding-bottom: 0 !important;
            margin-bottom: 1rem;
        }

        .settings-section {
            background: #fff;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            border: 1px solid #e5e7eb;
        }

        .settings-section h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .tab-buttons {
            display: flex;
            gap: 1rem;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Обработчик переключения вкладок
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                var targetTab = $(e.target).data('bs-target');
                
                // Скрываем все кнопки
                $('.tab-buttons').hide();
                
                // Показываем соответствующие кнопки
                if (targetTab === '#students') {
                    $('#students-buttons').show();
                } else {
                    $('#content-buttons').show();
                }
            });
            
            // Показываем правильные кнопки при загрузке страницы
            var activeTab = $('.nav-link.active').data('bs-target');
            if (activeTab === '#students') {
                $('#students-buttons').show();
            } else {
                $('#content-buttons').show();
            }
        });
    </script>
}
